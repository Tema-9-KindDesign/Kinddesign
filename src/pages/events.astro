---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/card.astro';

const endpoint = "https://zmuyycufsaccnnglqgtk.supabase.co/rest/v1/cards?"
const key = "sb_publishable_KIieHJeXrPVxgDq2fXhwsw_FraY9I5I"

const options = {
  method: "GET",
  headers: {
    apikey: key,
  },
};

const response = await fetch(endpoint, options);
const events: any[] = await response.json();
---

<Layout>
  <section class="hero">
    <div class="hero-content">
      <h1>EVENTS</h1>
      <h2>UPCOMING EVENTS</h2>
    </div>
  </section>

  <section class="events">
    {events.map((event) => (
      <EventCard event={event} />
    ))}
  </section>
</Layout>


<style>
  /* MOBILE FIRST */

  .hero {
    background-image: url('/images/events_banner.webp');
    background-size: cover;
    background-position: center;
    height: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
.hero-content h1 {
  font-family: 'headline';
  font-size: clamp(42px, 10vw, 100px);
  font-weight: 900;
  color: #f28ac8;
  margin: 0;
  line-height: 1;
}

.hero-content h2 {
  font-family: 'headline';
  font-size: 14px;
  font-weight: 700;
  color: white;
  margin-top: 12px;

}


  .hero p {
    color: white;
    font-size: 14px;
    font-weight: bold;
  }

  .events {
    display: flex;
    flex-direction: column;
    gap: 35px;
    padding: 25px 15px;
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .hero {
      height: 700px;
    }

    .hero h1 {
      font-size: 110px;
    }

    .hero p {
      font-size: 22px;
    }

    .events {
      gap: 100px;
      padding: 50px 25px 100px;
    }
  }
  @media (min-width: 768px) {
  .events {
    display: flex;
    flex-direction: column;
    gap: 30px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 30px 100px;
  }
}
</style>

